---
/**
 * 说说管理后台（自建 CMS）
 * 纯静态页面，通过 GitHub Contents API 直接提交内容到仓库，
 * push 后自动触发 deploy.yml 部署。无需任何服务器后端。
 *
 * 使用前需要创建 GitHub Token：
 * 1. 打开 https://github.com/settings/personal-access-tokens/new
 * 2. Repository access 选 "Only select repositories" 并选择本仓库
 * 3. Permissions → Repository permissions → Contents 设为 "Read and write"
 * 4. 生成后把 Token 粘贴到本页登录框即可（仅保存在浏览器本地）
 */
import "@/styles/main.css";
import { siteConfig } from "@/config";

// ====== 仓库配置，如仓库/分支有变请修改这里 ======
const OWNER = "VTESLEK";
const REPO = "Firefly";
const BRANCH = "master";
const CONTENT_DIR = "src/content/shuoshuo";
const IMAGE_DIR = "public/shuoshuo/images";
const HUE = siteConfig.themeColor.hue;
---

<!doctype html>
<html lang="zh_CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>说说管理</title>
    <link rel="icon" href="/favicon/favicon.ico" />
  </head>
  <body class="min-h-screen text-neutral-900 dark:text-neutral-100">
    <!-- ============ 登录视图 ============ -->
    <div id="ff-login" class="min-h-screen flex items-center justify-center px-4">
      <div class="w-full max-w-md bg-(--card-bg) border border-(--line-color) rounded-3xl p-8 shadow-sm">
        <div class="flex flex-col items-center text-center">
          <div class="h-14 w-14 rounded-2xl bg-(--primary) flex items-center justify-center text-white text-2xl mb-4 shadow-lg">✍️</div>
          <h1 class="text-2xl font-bold mb-1">说说管理后台</h1>
          <p class="text-sm text-(--content-meta) mb-6">登录 GitHub，随时随地发布说说</p>
        </div>
        <label class="block text-sm font-medium mb-2" for="ff-token">GitHub Token</label>
        <input
          id="ff-token"
          type="password"
          autocomplete="off"
          placeholder="github_pat_… 或 ghp_…"
          class="w-full h-11 px-4 rounded-xl bg-(--btn-regular-bg) border border-(--line-color) outline-none focus:border-(--primary) transition-colors font-mono text-sm"
        />
        <button
          id="ff-login-btn"
          class="mt-4 w-full h-11 rounded-xl bg-(--primary) text-white font-medium hover:opacity-90 active:scale-[0.98] transition-all flex items-center justify-center gap-2"
        >
          <span>登录</span>
        </button>
        <details class="mt-5 text-sm text-(--content-meta)">
          <summary class="cursor-pointer select-none hover:text-(--primary) transition-colors">如何获取 Token？</summary>
          <ol class="mt-2 space-y-1.5 list-decimal list-inside leading-relaxed">
            <li>打开 <span class="font-mono text-xs break-all">github.com/settings/personal-access-tokens/new</span></li>
            <li>Repository access 选「Only select repositories」，选择你的博客仓库</li>
            <li>Permissions → Contents 设为「Read and write」</li>
            <li>生成后复制粘贴到上面，点登录</li>
          </ol>
          <p class="mt-2 text-xs opacity-75">Token 只保存在你自己的浏览器里（localStorage），不会经过任何第三方服务器。</p>
        </details>
      </div>
    </div>

    <!-- ============ 主应用 ============ -->
    <div id="ff-app" class="hidden min-h-screen">
      <!-- 顶栏 -->
      <header class="sticky top-0 z-20 backdrop-blur-md bg-(--page-bg)/80 border-b border-(--line-color)">
        <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white">✍️</div>
            <span class="font-bold">说说管理</span>
          </div>
          <div class="flex items-center gap-3">
            <img id="ff-avatar" class="h-8 w-8 rounded-full border border-(--line-color)" alt="头像" />
            <button id="ff-logout" class="text-sm text-(--content-meta) hover:text-(--primary) transition-colors">退出</button>
          </div>
        </div>
        <!-- 标签栏 -->
        <nav class="max-w-2xl mx-auto px-4 flex gap-1">
          <button data-tab="editor" class="ff-tab flex-1 h-11 text-sm font-medium relative">发布</button>
          <button data-tab="list" class="ff-tab flex-1 h-11 text-sm font-medium relative">管理</button>
        </nav>
      </header>

      <main class="max-w-2xl mx-auto px-4 py-5 pb-24">
        <!-- ====== 发布视图 ====== -->
        <section id="ff-view-editor">
          <div class="bg-(--card-bg) border border-(--line-color) rounded-3xl p-5 space-y-4">
            <!-- 正文 -->
            <textarea
              id="ff-content"
              rows="5"
              placeholder="记录点什么… 支持 Markdown 语法"
              class="w-full resize-y min-h-28 p-4 rounded-2xl bg-(--btn-regular-bg) border border-(--line-color) outline-none focus:border-(--primary) transition-colors text-[15px] leading-relaxed placeholder:text-(--content-meta)/60"
            ></textarea>

            <!-- 标签 -->
            <div>
              <div class="flex flex-wrap items-center gap-1.5 mb-2" id="ff-tag-chips"></div>
              <input
                id="ff-tag-input"
                type="text"
                placeholder="添加标签，回车确认"
                class="w-full h-10 px-4 rounded-xl bg-(--btn-regular-bg) border border-(--line-color) outline-none focus:border-(--primary) transition-colors text-sm"
              />
            </div>

            <!-- 时间 + 图片 -->
            <div class="flex flex-wrap gap-3">
              <div class="flex-1 min-w-52">
                <label class="block text-xs text-(--content-meta) mb-1.5" for="ff-date">时间</label>
                <input
                  id="ff-date"
                  type="datetime-local"
                  class="w-full h-10 px-3 rounded-xl bg-(--btn-regular-bg) border border-(--line-color) outline-none focus:border-(--primary) transition-colors text-sm"
                />
              </div>
              <div class="flex-1 min-w-52">
                <label class="block text-xs text-(--content-meta) mb-1.5">配图</label>
                <div class="flex gap-2">
                  <button id="ff-img-pick" class="flex-1 h-10 rounded-xl bg-(--btn-regular-bg) border border-(--line-color) hover:border-(--primary) transition-colors text-sm flex items-center justify-center gap-1.5">
                    📷 上传图片
                  </button>
                  <button id="ff-img-clear" class="hidden h-10 px-3 rounded-xl bg-(--btn-regular-bg) border border-(--line-color) hover:border-red-400 transition-colors text-sm">移除</button>
                </div>
                <input id="ff-img-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" class="hidden" />
                <input id="ff-img-url" type="url" placeholder="或粘贴图片链接" class="w-full mt-2 h-9 px-3 rounded-xl bg-(--btn-regular-bg) border border-(--line-color) outline-none focus:border-(--primary) transition-colors text-xs" />
              </div>
            </div>

            <!-- 图片预览 -->
            <div id="ff-img-preview" class="hidden relative">
              <img class="w-full max-h-64 object-cover rounded-2xl border border-(--line-color)" alt="配图预览" />
            </div>

            <!-- 编辑模式提示 -->
            <div id="ff-editing-bar" class="hidden">
              <div class="flex items-center justify-between gap-2 px-4 py-2.5 rounded-xl bg-(--btn-regular-bg) text-sm">
                <span>正在编辑：<span id="ff-editing-name" class="font-mono text-xs"></span></span>
                <button id="ff-cancel-edit" class="text-(--content-meta) hover:text-(--primary) transition-colors">取消</button>
              </div>
            </div>

            <!-- 预览 -->
            <div>
              <button id="ff-preview-toggle" class="text-sm text-(--content-meta) hover:text-(--primary) transition-colors">▶ 预览</button>
              <div id="ff-preview" class="hidden mt-2 p-4 rounded-2xl bg-(--btn-regular-bg) border border-(--line-color) text-[15px] leading-relaxed ff-prose"></div>
            </div>
          </div>

          <!-- 发布按钮 -->
          <button
            id="ff-publish"
            class="mt-4 w-full h-12 rounded-2xl bg-(--primary) text-white font-medium text-[15px] hover:opacity-90 active:scale-[0.99] transition-all shadow-lg disabled:opacity-60 flex items-center justify-center gap-2"
          >
            <span id="ff-publish-text">发布说说</span>
          </button>
        </section>

        <!-- ====== 管理视图 ====== -->
        <section id="ff-view-list" class="hidden">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-(--content-meta)"><span id="ff-count">0</span> 条说说</span>
            <button id="ff-refresh" class="text-sm text-(--content-meta) hover:text-(--primary) transition-colors flex items-center gap-1">刷新</button>
          </div>
          <div id="ff-list" class="space-y-3"></div>
          <div id="ff-list-empty" class="hidden text-center py-16 text-(--content-meta)">
            <div class="text-4xl mb-3">🍃</div>
            <p class="text-sm">还没有说说，去「发布」第一条吧</p>
          </div>
        </section>
      </main>
    </div>

    <!-- ============ 确认弹窗 ============ -->
    <div id="ff-modal" class="hidden">
      <div class="fixed inset-0 z-50 flex items-center justify-center px-6">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="ff-modal-mask"></div>
        <div class="relative bg-(--card-bg) border border-(--line-color) rounded-3xl p-6 w-full max-w-xs text-center shadow-2xl">
          <p id="ff-modal-text" class="text-[15px] mb-5">确认删除？</p>
          <div class="flex gap-2">
            <button id="ff-modal-no" class="flex-1 h-10 rounded-xl bg-(--btn-regular-bg) text-sm hover:opacity-80 transition-opacity">取消</button>
            <button id="ff-modal-yes" class="flex-1 h-10 rounded-xl bg-red-500 text-white text-sm hover:opacity-90 transition-opacity">删除</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ Toast ============ -->
    <div id="ff-toasts" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 w-max max-w-[90vw]"></div>
  </body>

  <style is:global>
    html { scroll-behavior: smooth; }
    /* 标签栏激活态 */
    .ff-tab { color: var(--content-meta); transition: color 0.2s; }
    .ff-tab.active { color: var(--primary); }
    .ff-tab.active::after {
      content: "";
      position: absolute;
      left: 50%; bottom: 6px;
      transform: translateX(-50%);
      width: 1.5rem; height: 3px;
      border-radius: 999px;
      background: var(--primary);
    }
    /* 标签 chip */
    .ff-chip {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.2rem 0.65rem; border-radius: 999px;
      background: var(--btn-regular-bg);
      font-size: 0.8rem;
    }
    .ff-chip button { color: var(--content-meta); line-height: 1; padding: 0.1rem; }
    .ff-chip button:hover { color: #ef4444; }
    /* 简易 Markdown 预览 */
    .ff-prose p { margin: 0.35rem 0; }
    .ff-prose code {
      background: var(--btn-regular-bg);
      padding: 0.1rem 0.35rem; border-radius: 0.35rem; font-size: 0.85em;
    }
    .ff-prose a { color: var(--primary); text-decoration: underline; }
    /* toast 动画 */
    .ff-toast {
      padding: 0.6rem 1.1rem; border-radius: 999px;
      background: var(--card-bg);
      border: 1px solid var(--line-color);
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      font-size: 0.85rem;
      animation: ff-toast-in 0.25s ease;
    }
    .ff-toast.ok { color: var(--primary); }
    .ff-toast.err { color: #ef4444; }
    @keyframes ff-toast-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* 列表卡片入场 */
    .ff-item { animation: ff-item-in 0.3s ease both; }
    @keyframes ff-item-in {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* 加载圈 */
    .ff-spin {
      width: 1rem; height: 1rem;
      border: 2px solid rgb(255 255 255 / 0.4);
      border-top-color: white;
      border-radius: 999px;
      animation: ff-spin 0.7s linear infinite;
    }
    @keyframes ff-spin { to { transform: rotate(360deg); } }
    /* 文本域滚动条 */
    #ff-content::-webkit-scrollbar, #ff-preview::-webkit-scrollbar { width: 6px; }
    #ff-content::-webkit-scrollbar-thumb, #ff-preview::-webkit-scrollbar-thumb {
      background: var(--btn-regular-bg); border-radius: 999px;
    }
  </style>

  <script is:inline define:vars={{ OWNER, REPO, BRANCH, CONTENT_DIR, IMAGE_DIR, HUE }}>
    /* ================= 主题（色相 + 明暗跟随博客设置/系统） ================= */
    document.documentElement.style.setProperty("--hue", String(HUE));
    const themePref = localStorage.getItem("theme");
    const sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    if (themePref === "dark" || ((!themePref || themePref === "system" || themePref === "auto") && sysDark)) {
      document.documentElement.classList.add("dark");
    }

    /* ================= 常量与状态 ================= */
    const API = "https://api.github.com";
    const TOKEN_KEY = "ff-admin-token";
    const $ = (id) => document.getElementById(id);

    const state = {
      token: localStorage.getItem(TOKEN_KEY) || "",
      tags: [],
      image: "",          // 最终写入 frontmatter 的图片地址
      imageObjectUrl: "", // 本地预览用
      editing: null,      // { path, sha, name }
      cache: new Map(),   // path -> { sha, post }
      busy: false,
    };

    /* ================= 基础工具 ================= */
    function toast(msg, type = "ok", ms = 2600) {
      const el = document.createElement("div");
      el.className = `ff-toast ${type}`;
      el.textContent = msg;
      $("ff-toasts").appendChild(el);
      setTimeout(() => el.remove(), ms);
    }

    function confirmBox(text) {
      return new Promise((resolve) => {
        $("ff-modal-text").textContent = text;
        $("ff-modal").classList.remove("hidden");
        const done = (v) => {
          $("ff-modal").classList.add("hidden");
          $("ff-modal-yes").onclick = $("ff-modal-no").onclick = $("ff-modal-mask").onclick = null;
          resolve(v);
        };
        $("ff-modal-yes").onclick = () => done(true);
        $("ff-modal-no").onclick = () => done(false);
        $("ff-modal-mask").onclick = () => done(false);
      });
    }

    function setBusy(btn, busy, busyText) {
      state.busy = busy;
      btn.disabled = busy;
      if (busy) {
        btn.dataset.origText = btn.textContent;
        btn.innerHTML = `<span class="ff-spin"></span><span>${busyText}</span>`;
      } else {
        btn.textContent = btn.dataset.origText || btn.textContent;
      }
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
    }

    /* UTF-8 安全的 base64 编解码 */
    function b64encode(str) {
      const bytes = new TextEncoder().encode(str);
      let bin = "";
      for (let i = 0; i < bytes.length; i += 0x8000) {
        bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      }
      return btoa(bin);
    }
    function b64decode(b64) {
      const bin = atob(b64.replace(/\n/g, ""));
      const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
      return new TextDecoder("utf-8").decode(bytes);
    }

    /* 时间：统一使用东八区 */
    function shanghaiParts(d) {
      const p = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
      }).formatToParts(d);
      const g = (t) => p.find((x) => x.type === t).value;
      return { y: g("year"), mo: g("month"), d: g("day"), h: g("hour") === "24" ? "00" : g("hour"), mi: g("minute"), s: g("second") };
    }
    function nowForInput() {
      const t = shanghaiParts(new Date());
      return `${t.y}-${t.mo}-${t.d}T${t.h}:${t.mi}`;
    }
    function inputValueToDate(v) {
      // "YYYY-MM-DDTHH:mm" -> 带 +08:00 的 ISO
      return `${v}:00+08:00`;
    }
    function dateToInputValue(iso) {
      const t = shanghaiParts(new Date(iso));
      return `${t.y}-${t.mo}-${t.d}T${t.h}:${t.mi}`;
    }
    function fileStamp(d) {
      const t = shanghaiParts(d);
      return `${t.y}${t.mo}${t.d}-${t.h}${t.mi}${t.s}`;
    }
    function displayDate(iso) {
      return new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai", year: "numeric", month: "long", day: "numeric",
        hour: "2-digit", minute: "2-digit", hour12: false,
      }).format(new Date(iso));
    }

    /* ================= frontmatter 生成 / 解析 ================= */
    function buildMarkdown(post) {
      const lines = ["---", `date: ${post.date}`];
      if (post.tags.length > 0) {
        lines.push("tags:");
        for (const t of post.tags) lines.push(`  - ${t}`);
      }
      if (post.image) lines.push(`image: ${post.image}`);
      lines.push("---", "", post.body.trim(), "");
      return lines.join("\n");
    }

    function parseMarkdown(raw) {
      const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      const post = { date: nowForInput(), tags: [], image: "", body: raw.trim() };
      if (!m) return post;
      post.body = m[2].replace(/^\r?\n/, "").trim();
      let inTags = false;
      for (const line of m[1].split(/\r?\n/)) {
        if (/^tags:/.test(line)) { inTags = true; continue; }
        if (inTags) {
          const t = line.match(/^\s+-\s+(.+)$/);
          if (t) { post.tags.push(t[1].trim()); continue; }
          inTags = false;
        }
        let mt = line.match(/^date:\s*(.+)$/);
        if (mt) { post.date = mt[1].trim(); continue; }
        let mi = line.match(/^image:\s*(.+)$/);
        if (mi) { post.image = mi[1].trim(); }
      }
      return post;
    }

    /* ================= GitHub API ================= */
    async function api(path, options = {}) {
      const res = await fetch(`${API}${path}`, {
        ...options,
        headers: {
          Authorization: `Bearer ${state.token}`,
          Accept: "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28",
          "Content-Type": "application/json",
          ...(options.headers || {}),
        },
        body: options.body ? JSON.stringify(options.body) : undefined,
      });
      if (res.status === 401) {
        logout();
        throw new Error("Token 无效或已过期，请重新登录");
      }
      return res;
    }

    const listFiles = () =>
      api(`/repos/${OWNER}/${REPO}/contents/${CONTENT_DIR}?ref=${BRANCH}`).then((r) =>
        r.status === 404 ? [] : r.json()
      );

    const getFile = (path) =>
      api(`/repos/${OWNER}/${REPO}/contents/${path}?ref=${BRANCH}`).then(async (r) => {
        if (!r.ok) throw new Error(`读取失败 ${r.status}`);
        const j = await r.json();
        return { sha: j.sha, post: parseMarkdown(b64decode(j.content)) };
      });

    const putFile = (path, content, sha, message) =>
      api(`/repos/${OWNER}/${REPO}/contents/${path}`, {
        method: "PUT",
        body: { message, content: b64encode(content), branch: BRANCH, ...(sha ? { sha } : {}) },
      }).then(async (r) => {
        if (!r.ok) throw new Error(`提交失败 ${r.status}: ${(await r.json()).message || ""}`);
        return r.json();
      });

    const deleteFile = (path, sha, message) =>
      api(`/repos/${OWNER}/${REPO}/contents/${path}`, {
        method: "DELETE",
        body: { message, sha, branch: BRANCH },
      }).then((r) => {
        if (!r.ok) throw new Error(`删除失败 ${r.status}`);
      });

    const uploadImage = async (file) => {
      const ext = file.name.split(".").pop().toLowerCase();
      const name = `${fileStamp(new Date())}-${Math.random().toString(36).slice(2, 6)}.${ext}`;
      const buf = new Uint8Array(await file.arrayBuffer());
      let bin = "";
      for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode(...buf.subarray(i, i + 0x8000));
      const r = await api(`/repos/${OWNER}/${REPO}/contents/${IMAGE_DIR}/${name}`, {
        method: "PUT",
        body: { message: `shuoshuo: upload image ${name}`, content: btoa(bin), branch: BRANCH },
      });
      if (!r.ok) throw new Error(`图片上传失败 ${r.status}`);
      return `/shuoshuo/images/${name}`;
    };

    /* ================= 登录 / 登出 ================= */
    async function login() {
      const token = $("ff-token").value.trim();
      if (!token) return toast("请先填写 Token", "err");
      setBusy($("ff-login-btn"), true, "验证中…");
      try {
        const u = await fetch(`${API}/user`, {
          headers: { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" },
        });
        if (!u.ok) throw new Error("Token 验证失败，请检查是否正确");
        const user = await u.json();
        const repo = await fetch(`${API}/repos/${OWNER}/${REPO}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!repo.ok) throw new Error(`无法访问仓库 ${OWNER}/${REPO}，请确认 Token 已授权该仓库`);
        state.token = token;
        localStorage.setItem(TOKEN_KEY, token);
        $("ff-avatar").src = user.avatar_url;
        showApp();
      } catch (e) {
        toast(e.message, "err", 4000);
      } finally {
        setBusy($("ff-login-btn"), false);
      }
    }

    function logout() {
      localStorage.removeItem(TOKEN_KEY);
      state.token = "";
      $("ff-app").classList.add("hidden");
      $("ff-login").classList.remove("hidden");
    }

    function showApp() {
      $("ff-login").classList.add("hidden");
      $("ff-app").classList.remove("hidden");
      resetEditor();
      loadList();
    }

    /* ================= 编辑器 ================= */
    function renderTags() {
      const box = $("ff-tag-chips");
      box.innerHTML = "";
      for (const t of state.tags) {
        const chip = document.createElement("span");
        chip.className = "ff-chip";
        chip.innerHTML = `#${escapeHtml(t)}<button type="button" aria-label="移除标签">✕</button>`;
        chip.querySelector("button").onclick = () => {
          state.tags = state.tags.filter((x) => x !== t);
          renderTags();
        };
        box.appendChild(chip);
      }
    }

    function setImage(url, objectUrl) {
      state.image = url;
      state.imageObjectUrl = objectUrl || "";
      if (url) {
        $("ff-img-preview").classList.remove("hidden");
        $("ff-img-preview").querySelector("img").src = objectUrl || url;
        $("ff-img-clear").classList.remove("hidden");
        $("ff-img-url").value = objectUrl ? "" : url;
      } else {
        $("ff-img-preview").classList.add("hidden");
        $("ff-img-clear").classList.add("hidden");
        $("ff-img-url").value = "";
      }
    }

    function resetEditor() {
      state.tags = [];
      state.editing = null;
      setImage("");
      $("ff-content").value = "";
      $("ff-date").value = nowForInput();
      renderTags();
      $("ff-editing-bar").classList.add("hidden");
      $("ff-publish-text").textContent = "发布说说";
      $("ff-preview").classList.add("hidden");
      $("ff-preview-toggle").textContent = "▶ 预览";
    }

    function startEdit(item) {
      const p = item.post;
      state.editing = { path: item.path, sha: item.sha, name: item.name };
      state.tags = [...p.tags];
      setImage(p.image);
      $("ff-content").value = p.body;
      $("ff-date").value = dateToInputValue(p.date);
      renderTags();
      $("ff-editing-bar").classList.remove("hidden");
      $("ff-editing-name").textContent = item.name;
      $("ff-publish-text").textContent = "更新说说";
      switchTab("editor");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    /* 简易 Markdown 预览（先转义再渲染，安全） */
    function renderPreview() {
      const raw = escapeHtml($("ff-content").value.trim() || "（暂无内容）");
      const html = raw
        .split(/\n{2,}/)
        .map((p) => `<p>${p
          .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
          .replace(/\*([^*]+)\*/g, "<em>$1</em>")
          .replace(/`([^`]+)`/g, "<code>$1</code>")
          .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
          .replace(/\n/g, "<br/>")}</p>`)
        .join("");
      $("ff-preview").innerHTML = html;
    }

    async function publish() {
      if (state.busy) return;
      const body = $("ff-content").value.trim();
      const image = $("ff-img-url").value.trim() || state.image;
      if (!body && !image) return toast("写点什么或配张图再发布吧", "err");

      setBusy($("ff-publish"), true, state.editing ? "提交中…" : "发布中…");
      try {
        const post = {
          date: inputValueToDate($("ff-date").value || nowForInput()),
          tags: [...state.tags],
          image,
          body: body || "📷",
        };
        if (state.editing) {
          await putFile(state.editing.path, buildMarkdown(post), state.editing.sha, `shuoshuo: update ${state.editing.name}`);
          toast("已更新，部署约 1-2 分钟后生效");
        } else {
          const name = `${fileStamp(new Date())}.md`;
          await putFile(`${CONTENT_DIR}/${name}`, buildMarkdown(post), null, `shuoshuo: publish ${name}`);
          toast("发布成功，部署约 1-2 分钟后生效");
        }
        resetEditor();
        loadList();
      } catch (e) {
        toast(e.message, "err", 4500);
      } finally {
        setBusy($("ff-publish"), false);
      }
    }

    /* ================= 管理列表 ================= */
    async function loadList() {
      if (state.busy) return;
      setBusy($("ff-refresh"), true, "加载中…");
      try {
        const files = (await listFiles()).filter((f) => f.type === "file" && f.name.endsWith(".md"));
        const items = await Promise.all(
          files.map(async (f) => ({ ...f, ...(await getFile(f.path)) }))
        );
        items.sort((a, b) => (a.post.date < b.post.date ? 1 : -1));
        state.cache.clear();
        for (const it of items) state.cache.set(it.path, it);
        renderList(items);
      } catch (e) {
        toast(e.message, "err", 4500);
      } finally {
        setBusy($("ff-refresh"), false);
      }
    }

    function renderList(items) {
      const list = $("ff-list");
      list.innerHTML = "";
      $("ff-count").textContent = items.length;
      $("ff-list-empty").classList.toggle("hidden", items.length > 0);
      for (const it of items) {
        const p = it.post;
        const card = document.createElement("article");
        card.className = "ff-item bg-(--card-bg) border border-(--line-color) rounded-2xl p-4";
        card.innerHTML = `
          <div class="flex items-start justify-between gap-3 mb-2">
            <time class="text-xs text-(--content-meta)">${escapeHtml(displayDate(p.date))}</time>
            <div class="flex gap-1 shrink-0">
              <button data-act="edit" class="h-8 px-3 rounded-lg bg-(--btn-regular-bg) text-xs hover:border-(--primary) border border-transparent transition-all">编辑</button>
              <button data-act="del" class="h-8 px-3 rounded-lg bg-(--btn-regular-bg) text-xs hover:text-red-500 transition-all">删除</button>
            </div>
          </div>
          ${p.image ? `<img src="${escapeHtml(p.image)}" class="w-full max-h-56 object-cover rounded-xl mb-2 border border-(--line-color)" loading="lazy" onerror="this.style.display='none'"/>` : ""}
          <div class="text-[15px] leading-relaxed whitespace-pre-wrap break-words">${escapeHtml(p.body)}</div>
          ${p.tags.length ? `<div class="flex flex-wrap gap-1.5 mt-3">${p.tags.map((t) => `<span class="ff-chip">#${escapeHtml(t)}</span>`).join("")}</div>` : ""}
        `;
        card.querySelector('[data-act="edit"]').onclick = () => startEdit(it);
        card.querySelector('[data-act="del"]').onclick = async () => {
          if (await confirmBox(`确定删除这条说说吗？（${displayDate(p.date)}）`)) {
            try {
              await deleteFile(it.path, it.sha, `shuoshuo: delete ${it.name}`);
              toast("已删除，部署约 1-2 分钟后生效");
              loadList();
            } catch (e) {
              toast(e.message, "err", 4500);
            }
          }
        };
        list.appendChild(card);
      }
    }

    /* ================= 标签页切换 ================= */
    function switchTab(name) {
      document.querySelectorAll(".ff-tab").forEach((b) => b.classList.toggle("active", b.dataset.tab === name));
      $("ff-view-editor").classList.toggle("hidden", name !== "editor");
      $("ff-view-list").classList.toggle("hidden", name !== "list");
    }

    /* ================= 事件绑定 ================= */
    document.querySelectorAll(".ff-tab").forEach((b) => b.addEventListener("click", () => switchTab(b.dataset.tab)));
    $("ff-login-btn").addEventListener("click", login);
    $("ff-token").addEventListener("keydown", (e) => e.key === "Enter" && login());
    $("ff-logout").addEventListener("click", logout);
    $("ff-publish").addEventListener("click", publish);
    $("ff-refresh").addEventListener("click", loadList);
    $("ff-cancel-edit").addEventListener("click", () => { resetEditor(); });

    $("ff-tag-input").addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      e.preventDefault();
      const v = $("ff-tag-input").value.trim().replace(/^#/, "");
      if (v && !state.tags.includes(v)) { state.tags.push(v); renderTags(); }
      $("ff-tag-input").value = "";
    });

    $("ff-img-pick").addEventListener("click", () => $("ff-img-file").click());
    $("ff-img-file").addEventListener("change", async (e) => {
      const file = e.target.files[0];
      e.target.value = "";
      if (!file) return;
      if (file.size > 10 * 1024 * 1024) return toast("图片不能超过 10MB", "err");
      setBusy($("ff-img-pick"), true, "上传中…");
      try {
        const url = await uploadImage(file);
        setImage(url, URL.createObjectURL(file));
        toast("图片已上传");
      } catch (err) {
        toast(err.message, "err", 4500);
      } finally {
        setBusy($("ff-img-pick"), false, "上传中…");
        $("ff-img-pick").textContent = "📷 上传图片";
      }
    });
    $("ff-img-clear").addEventListener("click", () => setImage(""));
    $("ff-img-url").addEventListener("change", () => {
      const v = $("ff-img-url").value.trim();
      if (v && v !== state.image) setImage(v);
    });

    $("ff-preview-toggle").addEventListener("click", () => {
      const box = $("ff-preview");
      const hidden = box.classList.toggle("hidden");
      $("ff-preview-toggle").textContent = hidden ? "▶ 预览" : "▼ 收起预览";
      if (!hidden) renderPreview();
    });
    $("ff-content").addEventListener("input", () => {
      if (!$("ff-preview").classList.contains("hidden")) renderPreview();
    });

    /* ================= 自动登录 ================= */
    if (state.token) {
      fetch(`${API}/user`, { headers: { Authorization: `Bearer ${state.token}` } })
        .then((r) => {
          if (!r.ok) throw new Error();
          return r.json();
        })
        .then((user) => {
          $("ff-avatar").src = user.avatar_url;
          showApp();
        })
        .catch(() => localStorage.removeItem(TOKEN_KEY));
    }
  </script>
</html>
