---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

interface Props {
	slug: string;
	title: string;
	/** 构建期内容指纹（正文 sha256 前 16 位），用于文章更新后自动重新生成摘要 */
	fp?: string;
}
const { slug, title, fp } = Astro.props;
---

<div
	class="ai-summary-card rounded-xl px-5 py-4 mb-6 onload-animation"
	data-ai-summary
	data-slug={slug}
	data-title={title}
	data-fp={fp || ""}
	data-i18n-generating={i18n(I18nKey.aiSummaryGenerating)}
	data-i18n-failed={i18n(I18nKey.aiSummaryFailed)}
	data-pagefind-ignore
>
	<div class="flex items-center gap-2 mb-2">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<defs>
				<linearGradient id="ai-summary-spark" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" stop-color="var(--primary)"></stop>
					<stop offset="1" stop-color="#B48DF3"></stop>
				</linearGradient>
			</defs>
			<path
				d="M12 2.5 14.1 8 19.5 10 14.1 12 12 17.5 9.9 12 4.5 10 9.9 8Z"
				fill="url(#ai-summary-spark)"></path>
			<path
				d="M18.8 15.2 19.7 17.4 21.9 18.3 19.7 19.2 18.8 21.4 17.9 19.2 15.7 18.3 17.9 17.4Z"
				fill="url(#ai-summary-spark)"
				opacity=".65"></path>
		</svg>
		<span class="text-sm font-bold text-(--primary)">{i18n(I18nKey.aiSummary)}</span>
		<span data-ai-status class="text-xs text-black/40 dark:text-white/40"></span>
	</div>
	<div data-ai-body class="text-[0.9rem] text-black/75 dark:text-white/75 leading-relaxed min-h-11"></div>
	<div class="text-xs text-black/35 dark:text-white/35 mt-2">{i18n(I18nKey.aiSummaryDisclaimer)}</div>
</div>

<style>
	.ai-summary-card {
		background: linear-gradient(
			120deg,
			color-mix(in srgb, var(--primary) 8%, var(--card-bg)),
			color-mix(in srgb, var(--primary) 3%, var(--card-bg))
		);
		border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
		transition:
			border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
			box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.ai-summary-card:hover {
		border-color: color-mix(in srgb, var(--primary) 35%, transparent);
		box-shadow: 0 8px 32px color-mix(in srgb, var(--primary) 14%, transparent);
	}
	[data-ai-status].ai-active {
		animation: ai-pulse 1.2s ease-in-out infinite;
	}
	[data-ai-status].ai-retry {
		cursor: pointer;
		color: var(--primary);
	}
	[data-ai-body].typing::after {
		content: "▍";
		color: var(--primary);
		margin-left: 2px;
		animation: ai-cursor 0.9s steps(1) infinite;
	}
	@keyframes ai-pulse {
		0%,
		100% {
			opacity: 0.4;
		}
		50% {
			opacity: 1;
		}
	}
	@keyframes ai-cursor {
		50% {
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		if (window.__aiSummaryInit) return;
		window.__aiSummaryInit = true;

		// 打字机：逐字输出，尊重系统"减少动态效果"设置
		const typeText = (el, text) =>
			new Promise((resolve) => {
				if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					el.textContent = text;
					resolve();
					return;
				}
				el.textContent = "";
				el.classList.add("typing");
				let i = 0;
				const tick = () => {
					i += 1;
					el.textContent = text.slice(0, i);
					if (i >= text.length) {
						el.classList.remove("typing");
						resolve();
						return;
					}
					setTimeout(tick, 14 + Math.random() * 26);
				};
				tick();
			});

		const init = async (el) => {
			el.dataset.aiState = "loading";
			const slug = el.getAttribute("data-slug") || "";
			const title = el.getAttribute("data-title") || "";
			const fp = el.getAttribute("data-fp") || "";
			const body = el.querySelector("[data-ai-body]");
			const status = el.querySelector("[data-ai-status]");
			const msgGenerating = el.getAttribute("data-i18n-generating") || "…";
			const msgFailed = el.getAttribute("data-i18n-failed") || "";
			if (!slug || !body) {
				el.remove();
				return;
			}
			// 从渲染后的正文提取文本（加密文章未解密时为空，自动移除卡片）
			const article = ((document.querySelector(".markdown-content") || {}).innerText || "").trim();
			if (article.length < 80) {
				el.remove();
				return;
			}

			const start = async () => {
				try {
					el.dataset.aiState = "loading";
					let summary = "";
					// 先查缓存；没有则触发服务端生成（服务端写 KV，之后所有访客复用）
					const r1 = await fetch(
						`/api/ai-summary?slug=${encodeURIComponent(slug)}${fp ? `&fp=${fp}` : ""}`,
					);
					if (r1.ok) {
						summary = (await r1.json()).summary || "";
					} else {
						if (status) {
							status.textContent = msgGenerating;
							status.classList.add("ai-active");
						}
						const r2 = await fetch("/api/ai-summary", {
							method: "POST",
							headers: { "content-type": "application/json" },
							body: JSON.stringify({ slug, title, fp, content: article.slice(0, 12000) }),
						});
						if (!r2.ok) throw new Error(`HTTP ${r2.status}`);
						summary = (await r2.json()).summary || "";
					}
					if (!summary) throw new Error("empty");
					if (status) {
						status.textContent = "";
						status.classList.remove("ai-active");
					}
					await typeText(body, summary);
					el.dataset.aiState = "done";
				} catch (e) {
					el.dataset.aiState = "error";
					if (status) {
						status.textContent = msgFailed;
						status.classList.remove("ai-active");
						status.classList.add("ai-retry");
						status.onclick = () => {
							status.onclick = null;
							status.classList.remove("ai-retry");
							start();
						};
					}
				}
			};
			start();
		};

		const setup = () => {
			document.querySelectorAll("[data-ai-summary]:not([data-ai-state])").forEach(init);
		};

		// swup 软导航：内容替换完成后重新扫描；首次加载直接执行
		const bindSwup = () => {
			if (window.swup && window.swup.hooks) {
				window.swup.hooks.on("page:view", () => setup());
			} else {
				document.addEventListener("swup:enable", () => setup(), { once: true });
			}
		};
		// 等 DOM 解析完成再初始化：卡片在 .markdown-content 之前渲染，
		// 立即执行会因正文尚未进入 DOM 而误判为空、移除卡片
		const boot = () => {
			bindSwup();
			setup();
		};
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", boot, { once: true });
		} else {
			boot();
		}
	})();
</script>
